# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Static / media (local filesystem placeholders; S3 is configured separately)
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/
# Leave empty to use apps/backend/media
DJANGO_MEDIA_ROOT=

# PostgreSQL
POSTGRES_DB=joonak
POSTGRES_USER=joonak
POSTGRES_PASSWORD=joonak
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Run tasks inline instead of via the worker (only honored when DJANGO_DEBUG=true)
CELERY_TASK_ALWAYS_EAGER=false

# S3-compatible object storage placeholders (not required to run locally)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1
